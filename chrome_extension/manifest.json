{
  "manifest_version": 3,
  "name": "퍼플루 브라우저 손",
  "version": "2.0.0",
  "description": "퍼플루(PC의 AI 컴패니언)가 크롬을 진짜 마우스·키보드로 다루고, 사이트에 하이라이트·노트를 남겨요. 이 PC의 퍼플루에만 연결돼요.",
  "permissions": ["tabs", "scripting", "alarms", "storage", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "퍼플루 브라우저 손", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
